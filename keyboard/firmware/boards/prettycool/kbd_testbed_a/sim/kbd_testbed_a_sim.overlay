	i2c1: i2c@71000 {
		compatible = "zephyr,i2c-emul-controller";
		reg = <0x71000 4>;
		clock-frequency = <I2C_BITRATE_FAST>;
		#address-cells = <1>;
		#size-cells = <0>;
		#forward-cells = <1>;
		status = "okay";

		/* U_EXP1 TCA9535 (rail enables, bus-switch enables). Restored outputs 0xFFFF, output register 0x7C00, configuration
		 * 0x0000. nxp,pca95xx with neither has-pud nor has-interrupt-mask-reg (SPEC §8.4). */
		u_exp1: gpio@20 {
			compatible = "nxp,pca95xx";
			reg = <0x20>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
		};

		/* U_EXP2 TCA9535 (PRESENT_N, faults, alerts, mux and KVM resets, the USB-C detect interrupt). Restored outputs 0x0300, output register 0xFDFF, configuration
		 * 0xFCFF. nxp,pca95xx with neither has-pud nor has-interrupt-mask-reg (SPEC §8.4). */
		u_exp2: gpio@21 {
			compatible = "nxp,pca95xx";
			reg = <0x21>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			interrupt-gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
		};

		/* U_EXP3 TCA9535 (S1-S4 G4/G5, slot LEDs). Restored outputs 0x1FFF, output register 0xFF00, configuration
		 * 0xE000. nxp,pca95xx with neither has-pud nor has-interrupt-mask-reg (SPEC §8.4). */
		u_exp3: gpio@22 {
			compatible = "nxp,pca95xx";
