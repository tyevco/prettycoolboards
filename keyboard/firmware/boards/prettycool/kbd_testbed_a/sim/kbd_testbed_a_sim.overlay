		compatible = "zephyr,adc-emul";
		nchannels = <24>;
		ref-internal-mv = <3300>;
		#io-channel-cells = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		channel@1 {
			reg = <1>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@2 {
			reg = <2>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@3 {
			reg = <3>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@4 {
			reg = <4>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@9 {
			reg = <9>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@a {
			reg = <10>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@b {
			reg = <11>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@f {
			reg = <15>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@10 {
			reg = <16>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@11 {
			reg = <17>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@12 {
			reg = <18>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@13 {
			reg = <19>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@14 {
			reg = <20>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@16 {
			reg = <22>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};

		channel@17 {
			reg = <23>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 815)>;
			zephyr,resolution = <12>;
		};
	};

	/* The motherboard's own signals (SPEC §3, §4.3, §7.3), for the board service and the bring-up app. */
	testbed: testbed {
		compatible = "prettycool,kbd-testbed";
		en-5v-kvm-gpios = <&u_exp1 15 GPIO_ACTIVE_HIGH>;
		exp-int-gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
		kvm-present-gpios = <&u_exp2 5 GPIO_ACTIVE_LOW>;
		kvm-rst-gpios = <&u_exp2 9 GPIO_ACTIVE_LOW>;
		mux-rst-gpios = <&u_exp2 8 GPIO_ACTIVE_LOW>;
		pm-alert-gpios = <&u_exp2 7 GPIO_ACTIVE_LOW>;
		rig-mark-gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
		rig-trig-gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;
		s5-pg-gpios = <&u_exp2 11 GPIO_ACTIVE_HIGH>;
		slot-fault-gpios = <&u_exp2 6 GPIO_ACTIVE_LOW>;
		slot-sync-gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;
		usbc-int-gpios = <&u_exp2 12 GPIO_ACTIVE_LOW>;
		vsys-pg-gpios = <&u_exp2 10 GPIO_ACTIVE_HIGH>;
		ina226-vsys = <&ina_vsys>;
		ina226-mcu = <&ina_p3v3_mcu>;
		ina226-usb = <&ina_p3v3_usb>;
		typec = <&u_cc>;
		slot-mux = <&u_mux>;
		kvm-i2c = <&mux_ch5>;
		slot-ldo-milliamps = <300>;
		base-load-milliamps = <45>;
		vsys-budget-max-milliamps = <2800>;
		vsys-budget-unconfigured-milliamps = <100>;
		vsys-trip-milliamps = <2960 3330 3620>;
		kvm-trip-milliamps = <519 577 644>;
		kvm-rule-milliamps = <500>;
	};

	/* The five coupon slots (SPEC §4.2-§4.4). Lanes: io-channels = AN0..AN3 on their primary converter;
	 * alt-adc-channels = <lane adc channel> for every other converter that reaches the lane's pin. */
	slots {
		slot1: slot-1 {
			compatible = "prettycool,coupon-slot";
			slot = <1>;
			io-channels = <&adc1 1>, <&adc1 2>, <&adc1 3>, <&adc1 4>;
			io-channel-names = "AN0", "AN1", "AN2", "AN3";
			alt-adc-channels = <0 2 1  0 4 1  1 2 2  1 4 2  2 2 3  2 4 3  3 2 4  3 4 4>;
			g-gpios = <&gpioe 2 GPIO_ACTIVE_HIGH>, <&gpioe 3 GPIO_ACTIVE_HIGH>, <&gpioe 4 GPIO_ACTIVE_HIGH>, <&gpioe 5 GPIO_ACTIVE_HIGH>, <&u_exp3 0 GPIO_ACTIVE_HIGH>, <&u_exp3 1 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpioe 6 GPIO_ACTIVE_LOW>, <&gpioe 1 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpioc 14 GPIO_ACTIVE_LOW>;
			present-gpios = <&u_exp2 0 GPIO_ACTIVE_LOW>;
			en-3v3-gpios = <&u_exp1 0 GPIO_ACTIVE_HIGH>;
			en-5v-gpios = <&u_exp1 5 GPIO_ACTIVE_HIGH>;
			busen-gpios = <&u_exp1 10 GPIO_ACTIVE_LOW>;
			led-gpios = <&u_exp3 8 GPIO_ACTIVE_LOW>;
			ina226-3v3 = <&ina_p3v3_s1>;
			ina226-5v = <&ina_p5v_s1>;
			i2c-channel = <&mux_ch0>;
			rule-3v3-milliamps = <250>;
			rule-5v-milliamps = <500>;
			trip-3v3-milliamps = <256 292 335>;
			trip-5v-milliamps = <519 577 644>;
			rail-3v3 = <0>;
			rail-5v = <5>;
		};

		slot2: slot-2 {
			compatible = "prettycool,coupon-slot";
			slot = <2>;
			io-channels = <&adc1 5>, <&adc1 6>, <&adc1 7>, <&adc1 8>;
			io-channel-names = "AN0", "AN1", "AN2", "AN3";
			alt-adc-channels = <0 2 5  1 2 6  2 2 7  3 2 8>;
			g-gpios = <&gpiod 8 GPIO_ACTIVE_HIGH>, <&gpiod 9 GPIO_ACTIVE_HIGH>, <&gpiod 10 GPIO_ACTIVE_HIGH>, <&gpiod 14 GPIO_ACTIVE_HIGH>, <&u_exp3 2 GPIO_ACTIVE_HIGH>, <&u_exp3 3 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpiod 15 GPIO_ACTIVE_LOW>, <&gpiod 7 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpiod 6 GPIO_ACTIVE_LOW>;
			present-gpios = <&u_exp2 1 GPIO_ACTIVE_LOW>;
			en-3v3-gpios = <&u_exp1 1 GPIO_ACTIVE_HIGH>;
			en-5v-gpios = <&u_exp1 6 GPIO_ACTIVE_HIGH>;
			busen-gpios = <&u_exp1 11 GPIO_ACTIVE_LOW>;
			led-gpios = <&u_exp3 9 GPIO_ACTIVE_LOW>;
			ina226-3v3 = <&ina_p3v3_s2>;
			ina226-5v = <&ina_p5v_s2>;
			i2c-channel = <&mux_ch1>;
			rule-3v3-milliamps = <250>;
			rule-5v-milliamps = <500>;
			trip-3v3-milliamps = <256 292 335>;
			trip-5v-milliamps = <519 577 644>;
			rail-3v3 = <1>;
			rail-5v = <6>;
		};

		slot3: slot-3 {
			compatible = "prettycool,coupon-slot";
			slot = <3>;
			io-channels = <&adc1 9>, <&adc1 10>, <&adc1 11>, <&adc1 12>;
			io-channel-names = "AN0", "AN1", "AN2", "AN3";
			alt-adc-channels = <0 2 9  0 4 9  1 2 10  1 4 10  2 2 11  2 4 11  3 2 12  3 4 20>;
			g-gpios = <&gpiod 0 GPIO_ACTIVE_HIGH>, <&gpiod 1 GPIO_ACTIVE_HIGH>, <&gpiod 2 GPIO_ACTIVE_HIGH>, <&gpiod 3 GPIO_ACTIVE_HIGH>, <&u_exp3 4 GPIO_ACTIVE_HIGH>, <&u_exp3 5 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpiod 4 GPIO_ACTIVE_LOW>, <&gpiod 5 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpioe 0 GPIO_ACTIVE_LOW>;
			present-gpios = <&u_exp2 2 GPIO_ACTIVE_LOW>;
			en-3v3-gpios = <&u_exp1 2 GPIO_ACTIVE_HIGH>;
			en-5v-gpios = <&u_exp1 7 GPIO_ACTIVE_HIGH>;
			busen-gpios = <&u_exp1 12 GPIO_ACTIVE_LOW>;
			led-gpios = <&u_exp3 10 GPIO_ACTIVE_LOW>;
			ina226-3v3 = <&ina_p3v3_s3>;
			ina226-5v = <&ina_p5v_s3>;
			i2c-channel = <&mux_ch2>;
			rule-3v3-milliamps = <250>;
			rule-5v-milliamps = <500>;
			trip-3v3-milliamps = <256 292 335>;
			trip-5v-milliamps = <519 577 644>;
			rail-3v3 = <2>;
			rail-5v = <7>;
		};

		slot4: slot-4 {
			compatible = "prettycool,coupon-slot";
			slot = <4>;
			io-channels = <&adc1 13>, <&adc1 14>, <&adc1 15>, <&adc1 16>;
			io-channel-names = "AN0", "AN1", "AN2", "AN3";
			alt-adc-channels = <0 2 13  0 4 22  1 2 14  1 4 23  2 2 15  2 4 18  3 2 16  3 4 19>;
			g-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>, <&gpioc 7 GPIO_ACTIVE_HIGH>, <&gpioc 8 GPIO_ACTIVE_HIGH>, <&gpioc 9 GPIO_ACTIVE_HIGH>, <&u_exp3 6 GPIO_ACTIVE_HIGH>, <&u_exp3 7 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>, <&gpioc 12 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpiob 5 GPIO_ACTIVE_LOW>;
			present-gpios = <&u_exp2 3 GPIO_ACTIVE_LOW>;
			en-3v3-gpios = <&u_exp1 3 GPIO_ACTIVE_HIGH>;
			en-5v-gpios = <&u_exp1 8 GPIO_ACTIVE_HIGH>;
			busen-gpios = <&u_exp1 13 GPIO_ACTIVE_LOW>;
			led-gpios = <&u_exp3 11 GPIO_ACTIVE_LOW>;
			ina226-3v3 = <&ina_p3v3_s4>;
			ina226-5v = <&ina_p5v_s4>;
			i2c-channel = <&mux_ch3>;
			rule-3v3-milliamps = <250>;
			rule-5v-milliamps = <500>;
			trip-3v3-milliamps = <256 292 335>;
			trip-5v-milliamps = <519 577 644>;
			rail-3v3 = <3>;
			rail-5v = <8>;
		};

		slot5: slot-5 {
			compatible = "prettycool,coupon-slot";
			slot = <5>;
			io-channels = <&adc1 17>, <&adc4 15>, <&adc4 16>, <&adc4 17>;
			io-channel-names = "AN0", "AN1", "AN2", "AN3";
			alt-adc-channels = <0 2 17>;
			g-gpios = <&gpioe 9 GPIO_ACTIVE_HIGH>, <&gpioe 11 GPIO_ACTIVE_HIGH>, <&gpioe 13 GPIO_ACTIVE_HIGH>, <&gpioe 8 GPIO_ACTIVE_HIGH>, <&gpioe 10 GPIO_ACTIVE_HIGH>, <&gpioe 12 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpioe 14 GPIO_ACTIVE_LOW>, <&gpioe 7 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpioe 15 GPIO_ACTIVE_LOW>;
			/* TIM1_BKIN: never gpio_pin_configure() it while TIM1 runs (SPEC §5.3). */
			irq-is-tim1-bkin;
			present-gpios = <&u_exp2 4 GPIO_ACTIVE_LOW>;
			en-3v3-gpios = <&u_exp1 4 GPIO_ACTIVE_HIGH>;
			en-5v-gpios = <&u_exp1 9 GPIO_ACTIVE_HIGH>;
			busen-gpios = <&u_exp1 14 GPIO_ACTIVE_LOW>;
			led-gpios = <&u_exp3 12 GPIO_ACTIVE_LOW>;
			pg-5v-gpios = <&u_exp2 11 GPIO_ACTIVE_HIGH>;
			ina226-3v3 = <&ina_p3v3_s5>;
			ina226-5v = <&ina_p5v_s5>;
			i2c-channel = <&mux_ch4>;
			rule-3v3-milliamps = <250>;
			rule-5v-milliamps = <2000>;
			trip-3v3-milliamps = <256 292 335>;
			trip-5v-milliamps = <2010 2270 2460>;
			rail-3v3 = <4>;
			rail-5v = <9>;
		};
	};
};
