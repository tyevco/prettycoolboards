	i2c4: i2c@71004 {
		compatible = "zephyr,i2c-emul-controller";
		reg = <0x71004 4>;
		clock-frequency = <I2C_BITRATE_FAST>;
		#address-cells = <1>;
		#size-cells = <0>;
		#forward-cells = <1>;
		status = "okay";

		/* U_MUX TCA9548A: ch0-ch4 = S1-S5, ch5 = KVM, ch6/ch7 = test pads. The driver never pulses RESET (it only deasserts it) and starts
		 * its channel cache at 0 without writing the device: after a warm reset the board service deselects
		 * the mux itself (SPEC §3.5, §8.4). idle-disconnect: no channel stays selected between transfers. */
		u_mux: mux@70 {
			compatible = "ti,tca9548a";
			reg = <0x70>;
			#address-cells = <1>;
			#size-cells = <0>;
			reset-gpios = <&u_exp2 8 GPIO_ACTIVE_LOW>;
			i2c-mux-idle-disconnect;

			/* channel 0: S1 */
			mux_ch0: i2c@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/* channel 1: S2 */
			mux_ch1: i2c@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/* channel 2: S3 */
			mux_ch2: i2c@2 {
				reg = <2>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/* channel 3: S4 */
			mux_ch3: i2c@3 {
				reg = <3>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/* channel 4: S5 */
			mux_ch4: i2c@4 {
				reg = <4>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/* channel 5: J_KVM */
			mux_ch5: i2c@5 {
				reg = <5>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/* channel 6: test pads (U_CC's fallback home, SPEC §3.4) */
			mux_ch6: i2c@6 {
				reg = <6>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/* channel 7: test pads */
			mux_ch7: i2c@7 {
				reg = <7>;
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};

		/* every coupon's descriptor EEPROM, at 0x50 behind its mux channel: one model that
		 * answers for the selected channel's slot */
		sim_eeprom: eeprom@50 {
			compatible = "prettycool,sim-eeprom";
			reg = <0x50>;
		};
	};

