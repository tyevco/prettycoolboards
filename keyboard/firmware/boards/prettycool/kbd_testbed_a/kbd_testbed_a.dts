/* Clocks, SPEC §8.1: HSE 16 MHz crystal (no bypass), PLL1 M 4 N 80 Q 2 R 2 = 160 MHz, as the Nucleo. */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

/* HSI48 as on the Nucleo (RNG, CK48); the HS PHY takes the HSE (OTGHS_SEL = 0, stm32u5_usbotg_hs.dtsi). */
&clk_hsi48 {
	status = "okay";
};

/*
 * &clk_lse stays disabled (the SoC default): no LSE crystal on rev A, PC14 is S1_IRQ_N and PC15 is LED_N
 * (SPEC §5.2), and with no crystal the clock driver waits for LSERDY forever (SPEC §8.1). If an RTC is ever
 * enabled, clock it from the LSI.
 */

&pll1 {
	div-m = <4>;
	mul-n = <80>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll1>;
	clock-frequency = <DT_FREQ_M(160)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

&flash0 {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* As the Nucleo's layout (TZEN = 0). The bring-up app links at 0x08000000 (no MCUboot). */
		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00010000 DT_SIZE_K(1952)>;
		};

		slot1_partition: partition@1f8000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x001f8000 DT_SIZE_K(1960)>;
		};

		storage_partition: partition@3e2000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x003e2000 DT_SIZE_K(120)>;
		};
	};
};

/* Console: USART1 on PA9/PA10, the J_SWD STDC14's VCP pins (SPEC §7.2, §8.3). */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/*
 * KVM link (SPEC §7.4), disabled: an enabled UART idles its TX high, which would back-power an unpowered KVM
 * coupon through its RX pin (the slot power rule of SPEC §3.5 applied to J_KVM). Enable it only while
 * +5V_KVM is on.
 */
&uart4 {
	pinctrl-0 = <&uart4_tx_pc10 &uart4_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "disabled";
};

&gpdma1 {
	status = "okay";
};

&iwdg {
	status = "okay";
};

/* USB high speed on the embedded PHY (SPEC §7.1, §8.2). USB_SOF (PA8) to J_RIG; the OTG core drives it only
 * once its SOF output is enabled, which Zephyr v4.5.0 does not do. */
zephyr_udc0: &usbotg_hs {
	pinctrl-0 = <&usb_otg_hs_dm_pa11 &usb_otg_hs_dp_pa12 &usb_otg_hs_sof_pa8>;
	pinctrl-names = "default";
	status = "okay";
};

&otghs_phy {
	status = "okay";
};

/* I2C1, 400 kHz, 2.2 k pull-ups to +3V3: the 13 INA226s, the three TCA9535s and U_CC (SPEC §3.4). */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	/* bus recovery (SPEC §5.2: a warm reset mid-read can leave a target holding SDA low): open drain, or the
	 * recovery would drive SDA push-pull against it (i2c_stm32_common.c configures GPIO_OUTPUT_HIGH) */
	scl-gpios = <&gpiob 8 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	sda-gpios = <&gpiob 9 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	/* U_EXP1 TCA9535 (rail enables, bus-switch enables). Restored outputs 0xFFFF, output register 0x7C00, configuration
	 * 0x0000. nxp,pca95xx with neither has-pud nor has-interrupt-mask-reg (SPEC §8.4). */
	u_exp1: gpio@20 {
		compatible = "nxp,pca95xx";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};

	/* U_EXP2 TCA9535 (PRESENT_N, faults, alerts, mux and KVM resets, the USB-C detect interrupt). Restored outputs 0x0300, output register 0xFDFF, configuration
	 * 0xFCFF. nxp,pca95xx with neither has-pud nor has-interrupt-mask-reg (SPEC §8.4). */
	u_exp2: gpio@21 {
		compatible = "nxp,pca95xx";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
		interrupt-gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
	};

	/* U_EXP3 TCA9535 (S1-S4 G4/G5, slot LEDs). Restored outputs 0x1FFF, output register 0xFF00, configuration
	 * 0xE000. nxp,pca95xx with neither has-pud nor has-interrupt-mask-reg (SPEC §8.4). */
	u_exp3: gpio@22 {
		compatible = "nxp,pca95xx";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};

	/* VSYS: 0.02 ohm shunt, current LSB 125 uA (CAL 2048), full scale 4096 mA. */
	ina_vsys: ina226@40 {
		compatible = "ti,ina226";
		reg = <0x40>;
		current-lsb-microamps = <125>;
		rshunt-micro-ohms = <20000>;
	};

	/* +3V3_MCU: 0.5 ohm shunt, current LSB 5 uA (CAL 2048), full scale 164 mA. */
	ina_p3v3_mcu: ina226@41 {
		compatible = "ti,ina226";
		reg = <0x41>;
		current-lsb-microamps = <5>;
		rshunt-micro-ohms = <500000>;
	};

	/* +3V3_USB: 1 ohm shunt, current LSB 3 uA (CAL 1707), full scale 82 mA. */
	ina_p3v3_usb: ina226@42 {
		compatible = "ti,ina226";
		reg = <0x42>;
		current-lsb-microamps = <3>;
		rshunt-micro-ohms = <1000000>;
	};

	/* +3V3_S1: 0.24 ohm shunt, current LSB 11 uA (CAL 1939), full scale 341 mA. */
	ina_p3v3_s1: ina226@44 {
		compatible = "ti,ina226";
		reg = <0x44>;
		current-lsb-microamps = <11>;
		rshunt-micro-ohms = <240000>;
	};

	/* +3V3_S2: 0.24 ohm shunt, current LSB 11 uA (CAL 1939), full scale 341 mA. */
	ina_p3v3_s2: ina226@45 {
		compatible = "ti,ina226";
		reg = <0x45>;
		current-lsb-microamps = <11>;
		rshunt-micro-ohms = <240000>;
	};

	/* +3V3_S3: 0.24 ohm shunt, current LSB 11 uA (CAL 1939), full scale 341 mA. */
	ina_p3v3_s3: ina226@46 {
		compatible = "ti,ina226";
		reg = <0x46>;
		current-lsb-microamps = <11>;
		rshunt-micro-ohms = <240000>;
	};

	/* +3V3_S4: 0.24 ohm shunt, current LSB 11 uA (CAL 1939), full scale 341 mA. */
	ina_p3v3_s4: ina226@47 {
		compatible = "ti,ina226";
		reg = <0x47>;
		current-lsb-microamps = <11>;
		rshunt-micro-ohms = <240000>;
	};

	/* +3V3_S5: 0.24 ohm shunt, current LSB 11 uA (CAL 1939), full scale 341 mA. */
	ina_p3v3_s5: ina226@48 {
		compatible = "ti,ina226";
		reg = <0x48>;
		current-lsb-microamps = <11>;
		rshunt-micro-ohms = <240000>;
	};

	/* +5V_S1: 0.1 ohm shunt, current LSB 25 uA (CAL 2048), full scale 819 mA. */
	ina_p5v_s1: ina226@49 {
		compatible = "ti,ina226";
		reg = <0x49>;
		current-lsb-microamps = <25>;
		rshunt-micro-ohms = <100000>;
	};

	/* +5V_S2: 0.1 ohm shunt, current LSB 25 uA (CAL 2048), full scale 819 mA. */
	ina_p5v_s2: ina226@4a {
		compatible = "ti,ina226";
		reg = <0x4a>;
		current-lsb-microamps = <25>;
		rshunt-micro-ohms = <100000>;
	};

	/* +5V_S3: 0.1 ohm shunt, current LSB 25 uA (CAL 2048), full scale 819 mA. */
	ina_p5v_s3: ina226@4b {
		compatible = "ti,ina226";
		reg = <0x4b>;
		current-lsb-microamps = <25>;
		rshunt-micro-ohms = <100000>;
	};

	/* +5V_S4: 0.1 ohm shunt, current LSB 25 uA (CAL 2048), full scale 819 mA. */
	ina_p5v_s4: ina226@4c {
		compatible = "ti,ina226";
		reg = <0x4c>;
		current-lsb-microamps = <25>;
		rshunt-micro-ohms = <100000>;
	};

	/* +5V_S5: 0.02 ohm shunt, current LSB 125 uA (CAL 2048), full scale 4096 mA. */
	ina_p5v_s5: ina226@4d {
		compatible = "ti,ina226";
		reg = <0x4d>;
		current-lsb-microamps = <125>;
		rshunt-micro-ohms = <20000>;
	};

	/* U_CC TUSB320LAIRWBR: Type-C source advertisement, read only (SPEC §3.8, §8.4). Its INT_N reaches
	 * the MCU through U_EXP2 (no MCU pin). Zephyr v4.5.0 has no driver for it. */
	u_cc: typec@67 {
		compatible = "prettycool,tusb320";
		reg = <0x67>;
		int-gpios = <&u_exp2 12 GPIO_ACTIVE_LOW>;
		i2c-ready-ms = <100>;
		decide-ms = <200>;
	};
};

/* I2C4, 400 kHz, 2.2 k pull-ups to +3V3, to the slot mux only (SPEC §4.5). */
&i2c4 {
	pinctrl-0 = <&i2c4_scl_pb6 &i2c4_sda_pb7>;
	pinctrl-names = "default";
	/* bus recovery (SPEC §5.2: a warm reset mid-read can leave a target holding SDA low): open drain, or the
	 * recovery would drive SDA push-pull against it (i2c_stm32_common.c configures GPIO_OUTPUT_HIGH) */
	scl-gpios = <&gpiob 6 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	sda-gpios = <&gpiob 7 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	/* U_MUX TCA9548A: ch0-ch4 = S1-S5, ch5 = KVM, ch6/ch7 = test pads. The driver never pulses RESET (it only deasserts it) and starts
	 * its channel cache at 0 without writing the device: after a warm reset the board service deselects
	 * the mux itself (SPEC §3.5, §8.4). idle-disconnect: no channel stays selected between transfers. */
	u_mux: mux@70 {
		compatible = "ti,tca9548a";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;
		reset-gpios = <&u_exp2 8 GPIO_ACTIVE_LOW>;
		i2c-mux-idle-disconnect;

		/* channel 0: S1 */
		mux_ch0: i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		/* channel 1: S2 */
		mux_ch1: i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		/* channel 2: S3 */
		mux_ch2: i2c@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		/* channel 3: S4 */
		mux_ch3: i2c@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		/* channel 4: S5 */
		mux_ch4: i2c@4 {
			reg = <4>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		/* channel 5: J_KVM */
		mux_ch5: i2c@5 {
			reg = <5>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		/* channel 6: test pads (U_CC's fallback home, SPEC §3.4) */
		mux_ch6: i2c@6 {
			reg = <6>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		/* channel 7: test pads */
		mux_ch7: i2c@7 {
			reg = <7>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

/*
 * SPI2, shared by the slots through their bus switches (SPEC §4.3). No cs-gpios here: the SPI driver would
 * drive every listed CS high at init, into unpowered coupons (the CS lines go straight to the slots, SPEC
 * §3.5). Each slot node lists its own two CS lines; the application drives them.
 */
&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * Timers, disabled: their pins are slot lines, and an application that uses them enables both nodes in an
 * overlay. TIM2 is the frame timer (CH1 SLOT_SYNC out, CH3 RIG_TRIG capture; SPEC §6.1), TIM1 drives S5's
 * DRV8316 with its break input on S5_IRQ_N (SPEC §5.3), TIM8 sits behind S4's G0-G3.
 */
&timers2 {
	st,prescaler = <0>;
	status = "disabled";

	pwm2: pwm {
		pinctrl-0 = <&tim2_ch1_pa15 &tim2_ch3_pb10>;
		pinctrl-names = "default";
		status = "disabled";
	};
};

&timers1 {
	st,prescaler = <0>;
	status = "disabled";

	pwm1: pwm {
		pinctrl-0 = <&tim1_ch1_pe9 &tim1_ch2_pe11 &tim1_ch3_pe13 &tim1_ch1n_pe8 &tim1_ch2n_pe10 &tim1_ch3n_pe12 &tim1_bkin_pe15>;
		pinctrl-names = "default";
		status = "disabled";
	};
};

&timers8 {
	st,prescaler = <0>;
	status = "disabled";

	pwm8: pwm {
		pinctrl-0 = <&tim8_ch1_pc6 &tim8_ch2_pc7 &tim8_ch3_pc8 &tim8_ch4_pc9>;
		pinctrl-names = "default";
		status = "disabled";
	};
};

/* ADCs, SPEC §4.4, §6.2: kernel clock HCLK / 4 = 40 MHz; VREF+ = VDDA = +3V3A. Every lane is a channel on every
 * converter that reaches its pin (nets.LANE_ADC). Acquisition 391 cycles (ADC1/2) and 815 (ADC4, 814.5): slow
 * enough for any lane source of SPEC §4.9; the scan engine sets its own. */
&adc12_common {
	st,adc-prescaler = <4>;
	vref-mv = <3300>;
	st,adc-clock-source = "ASYNC";
	status = "okay";
};

&adc4_common {
	st,adc-prescaler = <4>;
	vref-mv = <3300>;
	st,adc-clock-source = "ASYNC";
	status = "okay";
};

