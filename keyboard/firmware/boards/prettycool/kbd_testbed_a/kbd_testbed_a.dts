			io-channel-names = "AN0", "AN1", "AN2", "AN3";
			alt-adc-channels = <0 2 17>;
			g-gpios = <&gpioe 9 GPIO_ACTIVE_HIGH>, <&gpioe 11 GPIO_ACTIVE_HIGH>, <&gpioe 13 GPIO_ACTIVE_HIGH>, <&gpioe 8 GPIO_ACTIVE_HIGH>, <&gpioe 10 GPIO_ACTIVE_HIGH>, <&gpioe 12 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpioe 14 GPIO_ACTIVE_LOW>, <&gpioe 7 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpioe 15 GPIO_ACTIVE_LOW>;
