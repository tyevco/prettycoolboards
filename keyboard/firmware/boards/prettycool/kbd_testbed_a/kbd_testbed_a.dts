			rule-5v-milliamps = <500>;
			trip-3v3-milliamps = <256 292 335>;
			trip-5v-milliamps = <519 577 644>;
			rail-3v3 = <2>;
			rail-5v = <7>;
		};

		slot4: slot-4 {
			compatible = "prettycool,coupon-slot";
			slot = <4>;
			io-channels = <&adc1 13>, <&adc1 14>, <&adc1 15>, <&adc1 16>;
			io-channel-names = "AN0", "AN1", "AN2", "AN3";
			alt-adc-channels = <0 2 13  0 4 22  1 2 14  1 4 23  2 2 15  2 4 18  3 2 16  3 4 19>;
			g-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>, <&gpioc 7 GPIO_ACTIVE_HIGH>, <&gpioc 8 GPIO_ACTIVE_HIGH>, <&gpioc 9 GPIO_ACTIVE_HIGH>, <&u_exp3 6 GPIO_ACTIVE_HIGH>, <&u_exp3 7 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>, <&gpioc 12 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpiob 5 GPIO_ACTIVE_LOW>;
			present-gpios = <&u_exp2 3 GPIO_ACTIVE_LOW>;
			en-3v3-gpios = <&u_exp1 3 GPIO_ACTIVE_HIGH>;
			en-5v-gpios = <&u_exp1 8 GPIO_ACTIVE_HIGH>;
			busen-gpios = <&u_exp1 13 GPIO_ACTIVE_LOW>;
			led-gpios = <&u_exp3 11 GPIO_ACTIVE_LOW>;
			ina226-3v3 = <&ina_p3v3_s4>;
			ina226-5v = <&ina_p5v_s4>;
			i2c-channel = <&mux_ch3>;
			rule-3v3-milliamps = <250>;
			rule-5v-milliamps = <500>;
			trip-3v3-milliamps = <256 292 335>;
			trip-5v-milliamps = <519 577 644>;
