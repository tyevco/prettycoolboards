/dts-v1/;
#include <st/u5/stm32u5a5Xj.dtsi>
#include <st/u5/stm32u5a5vjtx-pinctrl.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	model = "PrettyCool Keyboard rev A testbed motherboard (STM32U5A5VJT6; draft, not built)";
	compatible = "prettycool,kbd-testbed-a";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		led0 = &status_led;
		watchdog0 = &iwdg;
		volt-sensor0 = &vref1;
		die-temp0 = &die_temp;
	};

	leds {
		compatible = "gpio-leds";

		/* LED_N on PC15-OSC32_OUT: PC13-PC15 may sink but not source (SPEC §5.2), so it is active low. */
		status_led: led_n {
			gpios = <&gpioc 15 GPIO_ACTIVE_LOW>;
			label = "LED_N (PC15)";
		};
	};

	/* The motherboard's own signals (SPEC §3, §4.3, §7.3), for the board service and the bring-up app. */
	testbed: testbed {
		compatible = "prettycool,kbd-testbed";
		en-5v-kvm-gpios = <&u_exp1 15 GPIO_ACTIVE_HIGH>;
		exp-int-gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
		kvm-present-gpios = <&u_exp2 5 GPIO_ACTIVE_LOW>;
		kvm-rst-gpios = <&u_exp2 9 GPIO_ACTIVE_LOW>;
		mux-rst-gpios = <&u_exp2 8 GPIO_ACTIVE_LOW>;
		pm-alert-gpios = <&u_exp2 7 GPIO_ACTIVE_LOW>;
		rig-mark-gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
		rig-trig-gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;
		s5-pg-gpios = <&u_exp2 11 GPIO_ACTIVE_HIGH>;
		slot-fault-gpios = <&u_exp2 6 GPIO_ACTIVE_LOW>;
		slot-sync-gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;
		usbc-int-gpios = <&u_exp2 12 GPIO_ACTIVE_LOW>;
		vsys-pg-gpios = <&u_exp2 10 GPIO_ACTIVE_HIGH>;
		ina226-vsys = <&ina_vsys>;
		ina226-mcu = <&ina_p3v3_mcu>;
		ina226-usb = <&ina_p3v3_usb>;
		typec = <&u_cc>;
		slot-mux = <&u_mux>;
		kvm-i2c = <&mux_ch5>;
		slot-ldo-milliamps = <300>;
		base-load-milliamps = <45>;
		vsys-budget-max-milliamps = <2800>;
		vsys-budget-unconfigured-milliamps = <100>;
		vsys-trip-milliamps = <2960 3330 3620>;
		kvm-trip-milliamps = <519 577 644>;
		kvm-rule-milliamps = <500>;
	};

	/* The five coupon slots (SPEC §4.2-§4.4). Lanes: io-channels = AN0..AN3 on their primary converter;
	 * alt-adc-channels = <lane adc channel> for every other converter that reaches the lane's pin. */
	slots {
		slot1: slot-1 {
			compatible = "prettycool,coupon-slot";
			slot = <1>;
			io-channels = <&adc1 1>, <&adc1 2>, <&adc1 3>, <&adc1 4>;
			io-channel-names = "AN0", "AN1", "AN2", "AN3";
			alt-adc-channels = <0 2 1  0 4 1  1 2 2  1 4 2  2 2 3  2 4 3  3 2 4  3 4 4>;
			g-gpios = <&gpioe 2 GPIO_ACTIVE_HIGH>, <&gpioe 3 GPIO_ACTIVE_HIGH>, <&gpioe 4 GPIO_ACTIVE_HIGH>, <&gpioe 5 GPIO_ACTIVE_HIGH>, <&u_exp3 0 GPIO_ACTIVE_HIGH>, <&u_exp3 1 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpioe 6 GPIO_ACTIVE_LOW>, <&gpioe 1 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpioc 14 GPIO_ACTIVE_LOW>;
			present-gpios = <&u_exp2 0 GPIO_ACTIVE_LOW>;
			en-3v3-gpios = <&u_exp1 0 GPIO_ACTIVE_HIGH>;
			en-5v-gpios = <&u_exp1 5 GPIO_ACTIVE_HIGH>;
			busen-gpios = <&u_exp1 10 GPIO_ACTIVE_LOW>;
			led-gpios = <&u_exp3 8 GPIO_ACTIVE_LOW>;
			ina226-3v3 = <&ina_p3v3_s1>;
			ina226-5v = <&ina_p5v_s1>;
			i2c-channel = <&mux_ch0>;
			rule-3v3-milliamps = <250>;
			rule-5v-milliamps = <500>;
			trip-3v3-milliamps = <256 292 335>;
			trip-5v-milliamps = <519 577 644>;
			rail-3v3 = <0>;
			rail-5v = <5>;
		};

		slot2: slot-2 {
			compatible = "prettycool,coupon-slot";
			slot = <2>;
			io-channels = <&adc1 5>, <&adc1 6>, <&adc1 7>, <&adc1 8>;
			io-channel-names = "AN0", "AN1", "AN2", "AN3";
			alt-adc-channels = <0 2 5  1 2 6  2 2 7  3 2 8>;
			g-gpios = <&gpiod 8 GPIO_ACTIVE_HIGH>, <&gpiod 9 GPIO_ACTIVE_HIGH>, <&gpiod 10 GPIO_ACTIVE_HIGH>, <&gpiod 14 GPIO_ACTIVE_HIGH>, <&u_exp3 2 GPIO_ACTIVE_HIGH>, <&u_exp3 3 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpiod 15 GPIO_ACTIVE_LOW>, <&gpiod 7 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpiod 6 GPIO_ACTIVE_LOW>;
			present-gpios = <&u_exp2 1 GPIO_ACTIVE_LOW>;
			en-3v3-gpios = <&u_exp1 1 GPIO_ACTIVE_HIGH>;
			en-5v-gpios = <&u_exp1 6 GPIO_ACTIVE_HIGH>;
			busen-gpios = <&u_exp1 11 GPIO_ACTIVE_LOW>;
			led-gpios = <&u_exp3 9 GPIO_ACTIVE_LOW>;
			ina226-3v3 = <&ina_p3v3_s2>;
			ina226-5v = <&ina_p5v_s2>;
			i2c-channel = <&mux_ch1>;
			rule-3v3-milliamps = <250>;
			rule-5v-milliamps = <500>;
