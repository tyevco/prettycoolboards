if BOARD_KBD_TESTBED_A

# Init order on the slot I2C (SPEC §8.4): I2C1/I2C4 at I2C_INIT_PRIORITY, then the TCA9535s, then the mux
# (its reset-gpios is on U_EXP2), then the mux channels. The TCA954x driver asserts at build time that its
# channels come strictly after its root, which its own defaults (both I2C_INIT_PRIORITY) do not satisfy.
# The gap at I2C_INIT_PRIORITY + 1 leaves room for an application hook that reads the expanders' raw
# registers before the driver turns every pin into an input (the bring-up app's warm-reset snapshot).
config GPIO_PCA95XX_INIT_PRIORITY
	default 52
	depends on GPIO_PCA95XX

config I2C_TCA954X_ROOT_INIT_PRIO
	default 53
	depends on I2C_TCA954X

config I2C_TCA954X_CHANNEL_INIT_PRIO
	default 54
	depends on I2C_TCA954X

# U_EXP2 carries every motherboard interrupt (PRESENT_N, faults, alerts, PG, U_CC) to EXP_INT_N (SPEC §8.4).
config GPIO_PCA95XX_INTERRUPT
	default y
	depends on GPIO_PCA95XX

endif # BOARD_KBD_TESTBED_A
