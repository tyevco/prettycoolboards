	(text "U1: descriptor EEPROM, M24C02 at 0x50 (slot I2C channel)"
		(exclude_from_sim no)
		(at 142.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4a67894b-ecce-5157-9a92-391480d3b793")
	)
	(text "E2-E0 = GND -> 0x50 (SPEC §4.6). Powered from the slot's +3V3; no pull-ups here (4.7k on the motherboard).\nWC: 100k to GND = writable; bridge JP1 (WC to +3V3) to write-protect the descriptor once written."
		(exclude_from_sim no)
		(at 142.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "7cdd33f1-1c94-5fb2-ad42-d486bb9c9179")
	)
