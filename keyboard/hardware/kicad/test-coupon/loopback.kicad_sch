	(text "U10 SN74LV165A: samples G0-G5, INJ, SYNC; MOSI loops through SER"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "89e29c8f-a33f-5cc0-be0f-9e0c1041146f")
	)
	(text "CS1_N = SH/LD (low: load), CS0_N = CLK INH (shift only while selected), SCK = CLK, MOSI = SER.\nH (first bit out) = G0 ... C = G5, B = INJ, A = SYNC. I_off: no back-powering when +3V3 is off."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "a111c74c-b882-5c15-a3f3-ac68f62e910c")
	)
