	(text "J_S1: slot S1 socket, female 2 x 20, 2.54 mm (default coupon: Hall-effect)"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5b9cfa19-06fb-5f74-bce5-8d427166f1b7")
	)
	(text "Pinout = nets.SLOT_PINS (SPEC §4.2): odd pins one row, even pins the other.\nKEY (39): no net; plug hole 39 by hand at assembly (no key plug stocked, D2 of 2026-11-27).\nD3: 100R in series at the socket on CS0_N, CS1_N, IRQ_N, G0-G3; S1_<sig>_J at the pin.\nLanes: 47R in series, 1n C0G on the MCU side (place the 1n at the MCU pin, SPEC §4.3).\nSCL/SDA: 4.7k to the slot's own +3V3 (never back-powers a coupon). PRESENT_N: 100k up at U_EXP2.\nCoupons are not hot-plugged while LED_S1 is lit (SPEC §3.5)."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "ccc1af50-5f10-5c98-857c-547e0d8b243e")
	)
	(text "U_BS1: SN74CBTLV3125 bus switch, shared SPI2 and the frame tick"
		(exclude_from_sim no)
		(at 15.24 34.29 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1861ee6b-e619-5f1d-9eec-2969f67813f1")
	)
	(text "~OE = BUSEN_N_S1 from U_EXP1, 10k pull-up: open after a power-on (SPEC §3.5). Close it only once the\nslot's rails are up, open it before they go down. VCC = always-on +3V3; Ioff isolates an unpowered\ncoupon."
		(exclude_from_sim no)
		(at 15.24 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "72ac841e-6056-50b5-a163-38c5ced3feff")
	)
