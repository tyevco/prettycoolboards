	(text "U1: STM32U5A5VJT6 (LQFP100), pin map = nets.MCU_PINS (SPEC §5)"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "3f3541ad-f367-525e-b275-276b889589d0")
	)
	(text "OTG_HS on PA11/PA12 (the 90R pair, hand-routed, MCU rotated so pins 70/71 face J1: SPEC §7.1).\nNo LSE: PC14 = S1_IRQ_N, PC15 = LED_N (sink only). PA15 / PB4 (JTDI / NJTRST) are SLOT_SYNC / RIG_MARK.\nLanes: S<n>_AN<k>_ADC, the MCU side of each slot's 47R / 1n RC (the 1n sits at the pin, SPEC §4.3).\nPE15 = S5_IRQ_N is TIM1_BKIN: never gpio_pin_configure it (SPEC §5.3)."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "bd8d522c-244f-57be-9b6f-9d9c8219c8cd")
	)
	(text "Supply pins (DS13543 Figure 23)"
		(exclude_from_sim no)
		(at 15.24 29.21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "3fd870df-49e6-5528-a498-d11b3e88c722")
	)
	(text "100n at every VDD pin + 10u; VBAT = +3V3_MCU with 100n (no backup cell). VDDA and VREF+ = +3V3A:\n+3V3_SLOT through FB1 (ratiometric with the slot rails, VREFBUF off), 100n + 1u each.\nVDDUSB = +3V3_USB, 100n + 1u.\nVCAP: 4.7u X5R (ESR < 20 mOhm at 3 MHz, >= 10 V), nothing else on it."
		(exclude_from_sim no)
		(at 15.24 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "081c81d5-edb8-55ba-810c-e32be1678f41")
	)
	(text "HSE: 16 MHz crystal (SPEC §5.2)"
		(exclude_from_sim no)
		(at 15.24 43.18 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a6cad244-0fbe-5175-aa7b-c5d8dea5e805")
	)
	(text "X322516MLB4SI: 9 pF load, +/-10 ppm. 10p C0G each side (10 / 2 + ~4 pF stray). AN2867 margin 5.2\n(gm_crit 0.29 mA/V vs 1.5 mA/V, estimate). Keep the crystal and caps next to pins 12/13, GND guard."
		(exclude_from_sim no)
		(at 15.24 46.99 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "98f36a35-dc2e-50ff-b7b8-81f55e1748d4")
	)
	(text "BOOT0 and reset (SPEC §5.2, §7.2)"
		(exclude_from_sim no)
		(at 15.24 53.34 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "fc187bb3-0ac7-587b-b716-8ec558a63fed")
	)
	(text "BOOT0 (PH3): 10k pull-down; SW102 to +3V3_MCU. Enter the ROM bootloader from power-off (hold SW102, plug\nin J1): an MCU reset leaves the expanders and the mux as they were (SPEC §3.5).\nNRST: 100n, SW101 to GND, J_SWD pin 12."
		(exclude_from_sim no)
		(at 15.24 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "cb32cb14-b219-5ed8-b2a8-5549bc3876de")
	)
	(text "Status LED (PC15 sinks it)"
		(exclude_from_sim no)
		(at 15.24 64.77 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ac090021-a6dd-5a9f-8436-c19787868213")
	)
	(text "From +3V3 (not +3V3_MCU, SPEC §3.3) through 1k: about 1.4 mA."
		(exclude_from_sim no)
		(at 15.24 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "14d78011-4ed4-5ace-b9fd-558aabf6ca5c")
	)
