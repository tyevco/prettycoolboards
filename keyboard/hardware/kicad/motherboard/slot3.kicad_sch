	(text "J_S3: slot S3 socket, female 2 x 20, 2.54 mm (default coupon: shear)"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "48eef81d-5160-53ac-98ad-df70f99987c2")
	)
	(text "Pinout = nets.SLOT_PINS (SPEC §4.2): odd pins one row, even pins the other.\nKEY (39): no net; plug hole 39 by hand at assembly (no key plug stocked, D2 of 2026-11-27).\nD3: 100R in series at the socket on CS0_N, CS1_N, IRQ_N, G0-G3; S3_<sig>_J at the pin.\nLanes: 47R in series, 1n C0G on the MCU side (place the 1n at the MCU pin, SPEC §4.3).\nSCL/SDA: 4.7k to the slot's own +3V3 (never back-powers a coupon). PRESENT_N: 100k up at U_EXP2.\nCoupons are not hot-plugged while LED_S3 is lit (SPEC §3.5)."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "c6ab2552-e603-5106-8d9a-dc70d6274dfb")
	)
	(text "U_BS3: SN74CBTLV3125 bus switch, shared SPI2 and the frame tick"
		(exclude_from_sim no)
		(at 15.24 34.29 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "204eeffe-ad65-5c4b-b1de-c5ebf8120a50")
	)
	(text "~OE = BUSEN_N_S3 from U_EXP1, 10k pull-up: open after a power-on (SPEC §3.5). Close it only once the\nslot's rails are up, open it before they go down. VCC = always-on +3V3; Ioff isolates an unpowered\ncoupon."
		(exclude_from_sim no)
		(at 15.24 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "a512c419-7c67-5dac-bf20-72d0ddac5865")
	)
