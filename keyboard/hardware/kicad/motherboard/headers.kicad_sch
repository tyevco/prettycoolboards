	(text "J_RIG: latency rig, shrouded 2 x 5 box header, 2.54 mm (SPEC §7.3, D5), pins = nets.J_RIG_PINS"
		(exclude_from_sim no)
		(at 162.56 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f9e94865-c435-500b-8724-1bc9890dde42")
	)
	(text "33R in series on the outputs (RIG_MARK, SLOT_SYNC, USB_SOF) for the ribbon (up to about 150 mm).\nRIG_TRIG -> PB10 (TIM2_CH3 input capture). RIG_INJ -> JP_INJ1-5 (open by default, one slot at a time).\nRIG_VREF: +3V3 through 1k, a logic-level reference for the rig's buffers, not a supply."
		(exclude_from_sim no)
		(at 162.56 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "470e3138-cd6d-5333-9138-d4111b0c4dde")
	)
