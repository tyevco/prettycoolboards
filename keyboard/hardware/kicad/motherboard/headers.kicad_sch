	(text "SPI2: pull-downs and probe pads (SPEC §4.3, §5.2, §7.5)"
		(exclude_from_sim no)
		(at 15.24 85.09 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "50b7450f-a8a2-56e4-8ac5-9c787295144b")
	)
	(text "100k to GND on SLOT_SCK and SLOT_MOSI (nets.MCU_SIDE_PULLS; place them at PB13 / PB15): the ROM\nbootloader's SPI2 probe (AN2606 §4.3) sees a known level while every bus switch is open. About 33 uA\neach while driven high. Probe pads on the shared bus, the MCU side of the five bus switches."
		(exclude_from_sim no)
		(at 15.24 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "3f5e57e7-d20e-5540-9ea4-674913aa6ef0")
	)
