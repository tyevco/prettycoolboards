			(justify left top)
		)
		(uuid "7c3a7ef0-1799-5f68-adba-d8838fdf1286")
	)
	(text "+3V3_SLOT feeds the five slot 3.3 V switches; the firmware keeps their sum under 300 mA (about 0.5 W in\nthe SOT-223, SPEC §3.2). +3V3A: ratiometric with the slot rails. 1u in, 4.7u out (ST §6.2)."
		(exclude_from_sim no)
		(at 182.88 166.37 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
