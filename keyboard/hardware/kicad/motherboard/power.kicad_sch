	(text "U2: TPS259474L input circuit breaker, 3.33 A (2.96 / 3.33 / 3.62 A), OVLO 5.8 V, latch-off"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2c550b3f-eb59-5b29-9e50-ef6fd46c6e7c")
	)
	(text "R_ILM 1.00k (I_LIM = 3334 / R). OVLO 383k / 100k: 5.80 V. EN/UVLO 100k / 39k: on above 4.28 V.\ndVdt 2.2n: 0.9 V/ms, +3V3 up in about 4 ms (U_CC wants <= 25 ms). ITIMER 2.2n: 1.85 ms blanking.\nAbove I_LIM for longer, or at once above 2 x I_LIM, it turns off and stays off until VBUS is cycled.\nPG -> VSYS_PG: PGTH 100k / 44.2k on VSYS_IN (D4), falls at 3.51-3.64 V. The firmware keeps the board\nunder 2.8 A."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "154bebd4-c3b2-5202-bb7a-665152eb2fba")
	)
	(text "VSYS: 20 mR shunt, INA226 0x40 (U_PM40): the whole board, full scale 4.10 A, LSB 125 uA"
		(exclude_from_sim no)
		(at 15.24 31.75 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b965c30e-8fa5-59d2-b32b-b0b0c0bc4978")
	)
	(text "IN+ / IN- on PM40_SENSE_P / _N, Kelvin: net ties NT40P / NT40N at R38's pads (D4, SPEC §7.5).\nALERT -> PM_ALERT_N at the VSYS budget (SPEC §3.2, §8.4)."
		(exclude_from_sim no)
		(at 15.24 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "169778b9-6a7a-5e17-a330-3a1c55c8d0c5")
	)
