	(text "U4: LDL1117S33R, VSYS -> +3V3_SLOT (1.2 A, 60 uVrms); FB1 to +3V3A is on the MCU sheet"
		(exclude_from_sim no)
		(at 182.88 162.56 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
