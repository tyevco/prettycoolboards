	(text "U_MUX: TCA9548A at 0x70 on I2C4, one channel per slot (SPEC §4.5)"
		(exclude_from_sim no)
		(at 15.24 234.95 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b62d9926-91bd-5c63-b704-299602639bb9")
	)
	(text "ch0-ch4 = S1-S5 (4.7k pull-ups to each slot's +3V3 on its sheet), ch5 = J_KVM (pull-ups on the KVM\ncoupon), ch6/ch7 = probe pads only. ~RESET = MUX_RST_N (10k up). Coupons must not use 0x70.\nDeselect a slot's channel before its rails go down (SPEC §3.5)."
		(exclude_from_sim no)
		(at 15.24 238.76 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
