	(text "U_EXP2: TCA9535 at 0x21 (PRESENT_N, faults, alerts, power-good, mux and KVM resets, U_CC interrupt)"
		(exclude_from_sim no)
		(at 135.89 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "542c9be6-24fc-51d3-9d19-c94cec5064e3")
	)
	(text "INT -> EXP_INT_N (10k to +3V3, PC13). SLOT_FAULT_N and PM_ALERT_N: wired-OR, 10k pull-ups here.\nPRESENT_N: 100k up. MUX_RST_N 10k up (mux running); KVM_RST_N 10k down (KVM coupon in reset).\nP15-P17 spare: 10k to GND.\nThese states hold only after a power-on: an MCU reset leaves the outputs as they were (SPEC §3.5)."
		(exclude_from_sim no)
		(at 135.89 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "d34ba49d-4534-518d-9947-630cc4148fdd")
	)
