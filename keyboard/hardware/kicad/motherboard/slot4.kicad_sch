	(text "J_S4: slot S4 socket, female 2 x 20, 2.54 mm (default coupon: coil (G0-G3 on TIM8))"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "738f2c6b-a17e-535a-b659-b334c2a19d8a")
	)
	(text "Pinout = nets.SLOT_PINS (SPEC §4.2): odd pins one row, even pins the other.\nKEY (39): no net; plug hole 39 by hand at assembly (no key plug stocked, D2 of 2026-11-27).\nD3: 100R in series at the socket on CS0_N, CS1_N, IRQ_N, G0-G3; S4_<sig>_J at the pin.\nLanes: 47R in series, 1n C0G on the MCU side (place the 1n at the MCU pin, SPEC §4.3).\nSCL/SDA: 4.7k to the slot's own +3V3 (never back-powers a coupon). PRESENT_N: 100k up at U_EXP2.\nCoupons are not hot-plugged while LED_S4 is lit (SPEC §3.5)."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "bebed798-6ac9-5501-ae85-9ed7281bc86d")
	)
	(text "U_BS4: SN74CBTLV3125 bus switch, shared SPI2 and the frame tick"
		(exclude_from_sim no)
		(at 15.24 34.29 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9069d21e-7c1c-5db4-9208-bef20199bf52")
	)
	(text "~OE = BUSEN_N_S4 from U_EXP1, 10k pull-up: open after a power-on (SPEC §3.5). Close it only once the\nslot's rails are up, open it before they go down. VCC = always-on +3V3; Ioff isolates an unpowered\ncoupon."
		(exclude_from_sim no)
		(at 15.24 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "d3f5b0f4-09c4-5c80-885b-54cdf443b948")
	)
