	(text "U1: descriptor EEPROM, M24C02 at 0x50 (slot I2C channel)"
		(exclude_from_sim no)
		(at 142.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "31c56e45-e712-5937-a5df-ac7be0f5528f")
	)
	(text "E2-E0 = GND -> 0x50 (SPEC §4.6). Powered from the slot's +3V3; no pull-ups here (4.7k on the motherboard).\nWC: 100k to GND = writable; bridge JP1 (WC to +3V3) to write-protect the descriptor once written."
		(exclude_from_sim no)
		(at 142.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "d1e0ebdc-5060-566f-99b8-d5b2126c2aaf")
	)
