	(text "U10 TMUX1208: 8:1 mux onto lane AN0 (SEL = G0-G2, EN = G3)"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "323c7218-6844-55b4-b0d0-ba6d4b43f0cf")
	)
	(text "S1-S6 = K1, K2, K3, K4, REF1, REF2 (SEL 0-5); S7, S8 = the thermistor taps TEMP1, TEMP2 (SEL 6, 7).\nEN low: every switch off (AN0 undefined). RON 9 Ohm typ at 3.3 V; the buffer's input takes no current."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "648582e9-6ff6-5e33-991e-5397fbb4e58a")
	)
	(text "U12 OPA2365: lane buffers (AN0 = mux, AN1 = K1 direct)"
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0e291101-9774-5d9b-a174-3b15f91126fa")
	)
	(text "Unity-gain followers, 22 Ohm in series to the slot pin (SBOS365G §8.3.3); the lane's 47 Ohm + 1 nF\nfollow on the motherboard. R26 (0 Ohm, NOT FITTED) puts the mux output straight onto AN2: the unbuffered\nlane-drive experiment of SPEC §11 #21 (fitted, the selected sensor drives the lane's 1 nF)."
		(exclude_from_sim no)
		(at 15.24 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "4e6ee8b7-218a-5f89-864d-92a72b6176bb")
	)
	(text "Probe pads"
		(exclude_from_sim no)
		(at 15.24 36.83 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d9d0b0b3-8578-5269-a2f0-d29f4568acf7")
	)
	(text "Lanes, the mux output, K1's output and SEL_EN, for a scope at bring-up."
		(exclude_from_sim no)
		(at 15.24 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "f30e5826-e130-5668-8c20-a3d6d9d63114")
	)
