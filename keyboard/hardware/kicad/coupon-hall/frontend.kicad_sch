	(text "U11 SN74HC259: sensor enables (Q0-Q5 = K1, K2, K3, K4, REF1, REF2)"
		(exclude_from_sim no)
		(at 250.19 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0782798e-8321-52a9-80e1-e3914e585083")
	)
	(text "S0-S2 = G0-G2 (SEL), D = G3 (SEL_EN), G = G4, CLR = G5. CLR low + G low: demultiplexer, only the\naddressed sensor on while G3 is high (gated, 1 kHz). CLR high: write each address with G3 high, then\nG high holds them all on (8 kHz). CLR low + G high: all off. 100k pull-downs: every G-line low = all off.\nA subset: set SEL and G3 with G high, then pulse G low (SCLS134F 7.3: G high while the address changes)."
		(exclude_from_sim no)
		(at 250.19 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "d973c780-570a-5d5d-b1b2-999647c56c16")
	)
