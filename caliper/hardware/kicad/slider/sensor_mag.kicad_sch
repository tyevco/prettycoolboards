	(text "AS5311 linear encoder (BOTTOM side, over the magnetic tape)"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6c4e6607-a130-58aa-ac8d-405518434abc")
	)
	(text "Centred at (31, 6.0) on the bottom, long axis along X (beam axis), SPEC §2.1. Air gap 0.3 +/-0.1 mm to the tape.\n3.3 V operation: VDD5V and VDD3V3 both on +3V3_SNS (datasheet §7.7), 100n + 1u at pin 19.\nA/B -> PCNT (4x: 0.488 um/count), Index once per 2 mm pole pair, SSI (CSn/CLK/DO) for the 12-bit absolute\nposition + OCF/COF/LIN/MagINC/MagDEC. CSn must be low for A/B/Index. Prog to VSS (no OTP in rev A). PWM unused.\nNo copper pour, vias or magnetic parts in the tape window under the IC beyond what the bottom layer rules allow."
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "f83538c0-54ab-5159-863f-86ef90102a07")
	)
	(rectangle
		(start 12.7 17.78)
		(end 143.51 101.6)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "de61e286-328a-5d35-9201-4af81635e3fc")
	)
	(text "Magnetic-field indicator pull-ups"
		(exclude_from_sim no)
		(at 151.13 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "66e79969-9f7a-5c31-848d-96b55dd50d31")
	)
	(text "MagINCn / MagDECn are open drain (datasheet Table 1, §4.1): 10k to +3V3_SNS, so they read low (= 'alarm')\nwhen the sensor rail is off; the firmware only reads them with SNS_PWR_EN high."
		(exclude_from_sim no)
		(at 151.13 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "05861c00-f215-5e56-b273-378c0b6804b5")
	)
