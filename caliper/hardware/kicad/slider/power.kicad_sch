	(text "3V3 buck-boost: TPS63802 (VSYS 2.5-4.6 V -> +3V3, 2 A)"
		(exclude_from_sim no)
		(at 441.96 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ffa8bf2d-f6af-5061-b299-89863a1b6f2a")
	)
	(text "Buck-boost, not an LDO: Wi-Fi TX peaks ~355 mA (module datasheet) and the cell falls below 3.4 V (SPEC §3).\nEN tied to VSYS (always on), MODE = GND (power save: 11 uA Iq), PG unused.\nR3/R4 = 511k/91k -> 3.31 V (VFB 0.5 V, TI Table 10-5); the divider draws 5.5 uA (R2 <= 100k rule).\nL1 DFE201612E-R47M (TI Table 10-2). CIN 10u + COUT 22u per Fig. 10-1, plus 22u bulk C6 for the RF bursts.\nLayout: VIN/VOUT caps and L1 on the same layer as U3, GND pad 8 to the plane with >= 2 vias."
		(exclude_from_sim no)
		(at 441.96 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "f318a500-b821-56bc-8542-0b32f8909217")
	)
