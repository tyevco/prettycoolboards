		(uuid "94b579bc-2ee3-5c70-9b65-9775b516be5b")
	)
	(text "SDA/SCL 2.2k: BQ25180 0x6A, MAX17048 0x36, LSM6DSO 0x6B at 400 kHz (SPEC §6): ~205 ns rise (30-70 %)\nwith ~110 pF (4.7k gave 438 ns > 300 ns); 1.3 mA sink at VOL 0.4 V (fast mode allows 3 mA).\nMust stay on the always-on rail: the MAX17048 reads a low bus as 'disconnected' and sleeps."
		(exclude_from_sim no)
		(at 15.24 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "6c9f28c4-0e3c-5c62-a4a2-f480fd7ed6e1")
	)
