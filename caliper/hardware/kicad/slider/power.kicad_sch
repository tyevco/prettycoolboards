	(text "USB-C input and protection"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4721b8ce-32b6-5aa6-9882-33a12986f7fe")
	)
	(text "HRO TYPE-C-31-M-12 (USB 2.0 device, sink only). Separate 5.1k Rd per CC pin; D+/D- pairs tied at the\nconnector. USBLC6-2SC6 + SMF5.0A within 5 mm of J1, D+/D- routed through the ESD pads as a 90R pair.\nNo series resistors on D+/D- (inside the ESP32-S3, SPEC §5). Right board edge, y 26.5 (SPEC §2.1)."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "6deefc82-5571-535c-8740-ee3abf971cf6")
	)
