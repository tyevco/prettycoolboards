	(text "SDA/SCL 2.2k: BQ25180 0x6A, MAX17048 0x36, LIS2DW12 0x19 at 400 kHz (SPEC §6): ~205 ns rise (30-70 %)\nwith ~110 pF (4.7k gave 438 ns > 300 ns); 1.3 mA sink at VOL 0.4 V (fast mode allows 3 mA).\nMust stay on the always-on rail: the MAX17048 reads a low bus as 'disconnected' and sleeps."
		(exclude_from_sim no)
		(at 400.05 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
