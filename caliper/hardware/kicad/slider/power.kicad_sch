	(text "Sensor rail +3V3_SNS: TPS22917 (SNS_PWR_EN)"
		(exclude_from_sim no)
		(at 133.35 113.03 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9ecc1f3c-1524-50df-ba22-b2fc0e38a070")
	)
	(text "AS5311 (~16 mA) + capacitive front-end. Off in sleep. CT 1n to VIN (slew ~ms, no +3V3 droop);\nQOD tied to VOUT (internal R) so the rail discharges when off. R5 holds ON low while the ESP32 is in reset.\nFirmware: drive MAG_CSN / MAG_CLK low before SNS_PWR_EN goes low (no back-powering through the ESD diodes)."
		(exclude_from_sim no)
		(at 133.35 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "3e4bfe2c-8a98-54ee-9c00-337bc481281f")
	)
