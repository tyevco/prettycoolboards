		)
		(uuid "4ad61b65-379c-5232-8e56-a58c7fef9758")
	)
	(text "UI rail +3V3_UI: TPS22917 (also on SNS_PWR_EN)"
		(exclude_from_sim no)
		(at 438.15 107.95 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ee00985a-c081-5732-9264-cabba3189549")
	)
	(text "LCD logic VDD (ST7789 sleep-in still draws 15+5 uA typ, DM-TFT114 §5.3) + WS2812 RGB LED: both off in deep sleep.\nShares SNS_PWR_EN (no free GPIO): the rails are on together whenever the caliper is awake.\nFirmware: drive the LCD_* lines and RGB_DIN low before switching off."
		(exclude_from_sim no)
		(at 438.15 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
