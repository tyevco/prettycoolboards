	(text "LiPo connector J2 (~135 mAh 1S, JST-SH 2-pin) + reverse-polarity P-FET Q1"
		(exclude_from_sim no)
		(at 137.16 182.88 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "aa932f24-8f45-5805-a9ec-b0f9bd611d5b")
	)
	(text "Pin 1 = BAT+, pin 2 = GND. Pack leads are not standardised: check every pack's polarity anyway.\nQ1 AO3401A in the BAT+ lead: drain to J2, source to VBAT, gate to GND via R10. The body diode conducts for a\ncorrect cell, then VGS = -VBAT turns the channel on (both directions, so charging works). A reversed cell\nleaves VGS = 0: off. VGS max +-12 V vs 4.4 V: no zener. 0.5 A: <= 43 mV / 21 mW (85 mOhm max at VGS -2.5 V).\nJ2 is on the bottom; it, the plug and the cell sit in the housing pocket behind the board (SPEC §2.1)."
		(exclude_from_sim no)
		(at 137.16 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "2cfcceee-023a-57ff-8f5a-9715d9932401")
	)
