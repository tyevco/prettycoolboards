	(text "TX phase isolation jumpers (0R, DNP to disconnect the experiment)"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5e7cd6ce-232d-51af-aa6c-670fe64917e4")
	)
	(text "Fit R60-R67 to drive the electrodes; leave them off and the eight GPIOs are free test pads."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "8a104b9e-24a9-5b84-9424-34655bf74a66")
	)
	(text "TX series resistors (100R: edge-rate limit, EMI, GPIO protection)"
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1671b07e-af8a-5ecc-ad24-37a90ee0b4e8")
	)
	(text "Next to the comb, on the electrode side of the jumpers. Phase n drives every 8th finger (pitch 0.635 mm)."
		(exclude_from_sim no)
		(at 15.24 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "01c38b2f-202e-52a3-b228-064392ac8d5e")
	)
	(text "Electrodes (bottom copper, E40 = seed pads; not a BOM part)"
		(exclude_from_sim no)
		(at 15.24 29.21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "8bdf8bbd-ac7e-5b19-b67b-d8b159cc4121")
	)
	(text "Comb x = 11...51, y = 12.5...17.5; RX strip y = 10.6...11.8 (SPEC §2.1). Bottom mask open over both.\nGuard GND around the RX strip and the CAP_EL_RX trace on all layers; nothing else on the bottom in y = 9...19."
		(exclude_from_sim no)
		(at 15.24 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "fd1055f0-9674-5b43-9cd0-b70f65906b98")
	)
	(text "RX jumper + charge amplifier (U40A)"
		(exclude_from_sim no)
		(at 15.24 39.37 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "bbbaefdc-81f9-5d32-8f58-cc2a077f9b61")
	)
	(text "Q = C*V: Cf 10p C0G || Rf 10M (HPF corner 1.6 kHz, far below the 25-100 kHz drive). Output centred on VREF.\nKeep the CAP_RX_IN node tiny, guarded, no mask opening on it except at the electrode."
		(exclude_from_sim no)
		(at 15.24 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "20327f21-da40-5222-8d60-acd04955cdbb")
	)
	(text "VREF = +3V3_SNS / 2, buffered (U40B)"
		(exclude_from_sim no)
		(at 15.24 48.26 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2e1a7377-5264-520e-9b62-ef06a92dcd8a")
	)
	(text "100k/100k divider (16.5 uA, only while +3V3_SNS is on) filtered by C41 1u, unity-gain buffer U40B.\nThe buffer output drives only U40A's + input (no capacitive load on the op-amp output)."
		(exclude_from_sim no)
		(at 15.24 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "0881e3c1-fa60-51e4-ab8a-9829bed87742")
	)
	(text "2nd-order RC low-pass (~408 kHz per pole) -> CAP_RX (ADC1_CH0)"
		(exclude_from_sim no)
		(at 15.24 58.42 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "10d9abac-3bc2-577d-98ee-d000929f6114")
	)
	(text "390R/1n then 3.9k/100p C0G (second stage 10x the impedance, so it barely loads the first).\nAnti-alias + kills the op-amp's HF noise; the synchronous demodulation is done in firmware."
		(exclude_from_sim no)
		(at 15.24 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "47ba4af2-24d3-5b03-b548-35aa7fec3221")
	)
	(text "Test points"
		(exclude_from_sim no)
		(at 15.24 67.31 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "091bdc47-8551-5def-a51d-f02bf4007792")
	)
	(text "Charge-amp output and VREF for scope probing"
		(exclude_from_sim no)
		(at 15.24 71.12 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "11262e5d-1635-5011-8b4b-efedbbe62a61")
	)
