	(text "LCD: 1.14in 240x135 ST7789 IPS, 13-pin 0.5 mm FPC (J50)"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5d43b714-a00e-50e4-892b-25937d873a77")
	)
	(text "Pin map: DM-TFT114-397 §3.1 (1 NC, 2 NC, 3 SDA, 4 SCL, 5 RS=D/C, 6 RESET, 7 CS, 8 GND, 9 NC, 10 VDD, 11 LEDK, 12 LEDA, 13 GND).\nSPI2 40 MHz write-only (SPEC §6). VDD from the switched +3V3_UI rail. 1u + 100n at pin 10.\nBeside the module on top; the glass is glued to the bezel, not the board (SPEC §2.1).\nCheck the bought panel's pin order and 0.5 mm tail pitch before ordering (vendors differ)."
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "94a29890-f653-53af-928e-affaf72cc405")
	)
	(rectangle
		(start 12.7 17.78)
		(end 144.78 96.52)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "0fba2676-fddd-5bde-b675-08cef14d6642")
	)
	(text "Backlight: low-side N-MOSFET on LCD_BL (PWM)"
		(exclude_from_sim no)
		(at 152.4 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "aea95432-2c31-59e7-82e0-f020b88e94b2")
	)
	(text "+3V3 -> R50 15R -> LEDA, LEDK -> Q50 -> GND. 1 white LED, VF 3.0 V (2.9-3.1) at 20 mA.\n(3.31 V - VF) / 15R: 20 mA at VF 3.0, 27 mA max at 2.9, 14 mA at 3.1 (10R gave 31-41 mA).\nHeadroom is only ~0.3 V, so brightness follows VF and the +3V3 tolerance; dim by PWM (LEDC, ~20 kHz).\nR51 100k holds the gate low while GPIO38 floats in reset."
		(exclude_from_sim no)
		(at 152.4 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "be02b43d-1bc3-5d33-9e94-bcf7a67608c0")
	)
	(rectangle
		(start 149.86 17.78)
		(end 256.54 78.74)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "18313ebf-0a16-5ec8-9e41-614b091e611a")
	)
	(text "Buttons: ZERO / HOLD-SEND / MODE (active low, RTC GPIOs 17/18/21 for deep-sleep wake)"
		(exclude_from_sim no)
		(at 15.24 104.14 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "98580c68-932d-58c8-9d7c-b66250f5981b")
	)
	(text "100k pull-up (no static current) + 100n to GND: 10 ms RC debounce; ext1 wake on any-low.\nTS-1088 3.9x2.9 mm top tact switches on the top edge band: ZERO x~8, HOLD x~20, MODE x~54 (SPEC §2.1)."
		(exclude_from_sim no)
		(at 15.24 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "4e65b928-07fa-5e86-b21b-48b4eee22366")
	)
	(rectangle
		(start 12.7 101.6)
		(end 167.64 158.75)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "7db17989-190d-575b-9879-33e577ab81ce")
	)
	(text "RGB status LED: WS2812B-2020-V6 on +3V3_UI (GPIO46 = RGB_DIN)"
		(exclude_from_sim no)
		(at 175.26 104.14 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9979bfe1-4989-5f76-9d6c-759b1d5f1495")
	)
	(text "3.3-5.3 V part (LCSC C52917434), so no level shifter: DIN at 3.3 V logic = VDD. Off with +3V3_UI in sleep.\nR55 100k pull-down: GPIO46 is a strap (must be 0/float at reset). 100n at VDD."
		(exclude_from_sim no)
		(at 175.26 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "3353a861-2bd4-52f4-bbd8-266c63b4b3fd")
	)
	(rectangle
