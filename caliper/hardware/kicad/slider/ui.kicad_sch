	(text "Piezo: Murata PKMCS0909E4000-R1 (4 kHz, external drive), low-side MOSFET on BUZZ (GPIO45)"
		(exclude_from_sim no)
		(at 143.51 132.08 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0e809c48-b210-597f-8afa-a7c4134fedf4")
	)
	(text "+3V3 -> BZ50 || R57 1k -> Q51 drain. LEDC square wave at ~4 kHz on the gate. R57 recharges the piezo\nwhile Q51 is off (3.3 mA only while Q51 conducts). R56 100k gate pull-down: GPIO45 is the VDD_SPI strap\nand must read 0 at reset (SPEC §5)."
		(exclude_from_sim no)
		(at 143.51 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "76dc0e09-ce80-573d-adb6-3ce4a9070f2d")
	)
