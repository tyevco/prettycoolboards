	(text "LCD: 1.14in 240x135 ST7789 IPS, 13-pin 0.5 mm FPC (J50)"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5d43b714-a00e-50e4-892b-25937d873a77")
	)
	(text "Pin map: DM-TFT114-397 §3.1 (1 NC, 2 NC, 3 SDA, 4 SCL, 5 RS=D/C, 6 RESET, 7 CS, 8 GND, 9 NC, 10 VDD, 11 LEDK, 12 LEDA, 13 GND).\nSPI2 40 MHz write-only (SPEC §6). VDD from the switched +3V3_UI rail. 1u + 100n at pin 10.\nBeside the module on top; the glass is glued to the bezel, not the board (SPEC §2.1).\nCheck the bought panel's pin order and 0.5 mm tail pitch before ordering (vendors differ)."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "4080afa4-5516-5834-87a9-331391c1567f")
	)
	(text "Backlight: low-side N-MOSFET on LCD_BL (PWM)"
		(exclude_from_sim no)
		(at 15.24 29.21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "aea95432-2c31-59e7-82e0-f020b88e94b2")
	)
	(text "+3V3 -> R50 15R -> LEDA, LEDK -> Q50 -> GND. 1 white LED, VF 3.0 V (2.9-3.1) at 20 mA.\n(3.31 V - VF) / 15R: 20 mA at VF 3.0, 27 mA max at 2.9, 14 mA at 3.1 (10R gave 31-41 mA).\nHeadroom is only ~0.3 V, so brightness follows VF and the +3V3 tolerance; dim by PWM (LEDC, ~20 kHz).\nR51 100k holds the gate low while GPIO38 floats in reset."
		(exclude_from_sim no)
		(at 15.24 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "922c2d01-ade8-55a3-ade8-b520092e787a")
	)
