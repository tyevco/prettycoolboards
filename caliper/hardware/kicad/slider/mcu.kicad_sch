	(text "Pin map = nets.MCU_PINS (SPEC §5); caliper/hardware/design/check_contract.py checks the netlist against it.\nAntenna end on the top board edge (y = 34), hanging clear of the steel beam; copper keep-out on all layers\nunder the antenna (Espressif HW design guidelines). EPAD + GND pads to the plane with a via array.\nN8R2 is not stocked at LCSC (2026-11); N4R2 C3013941 is. IO26 is the PSRAM CS: left unconnected."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "579dd23c-07a3-5958-ae47-7cbef683d449")
	)
	(text "3V3 decoupling at the module"
		(exclude_from_sim no)
		(at 15.24 29.21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4f09e8fe-57e6-5abb-b50c-379a10e0c014")
	)
	(text "22u + 100n at pad 3 (datasheet Fig. 9-1), < 2 mm, own GND vias"
		(exclude_from_sim no)
		(at 15.24 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "9bb27da6-4f1b-5b1f-b7b4-c74e7c056c20")
	)
	(text "EN reset delay"
