	(text "Compass: IIS2MDC 3-axis magnetometer on the system I2C (addr 0x1E, fixed)"
		(exclude_from_sim no)
		(at 177.8 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d97c6735-8ef0-5301-978c-1704ccba6c00")
	)
	(text "Always on (+3V3). Polled over I2C: INT/DRDY is not connected (no free ESP32 pin; high impedance by default).\nAwake: low-power mode, 10 Hz, offset cancellation on (50 uA, datasheet Table 11). Asleep: idle (1.5 uA typ).\nCS high = I2C. C1: 220n X7R right at pins 5 / 6 (current pulses). 100n + 10u at Vdd (pin 9), 100n at Vdd_IO (pin 10).\nPlaced in the top band, as far from the steel beam and the magnetic tape as the board allows (SPEC 17).\nKeep tracks that carry more than 10 mA a few millimetres away (datasheet 5.2)."
		(exclude_from_sim no)
		(at 177.8 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "d029f594-0d23-591e-afe1-7c73e57c2132")
	)
