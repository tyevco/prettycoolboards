	(text "Accelerometer: LIS2DW12 on the system I2C (addr 0x19, SA0 high)"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "eec25c45-177e-5424-b381-fb096ae03ce9")
	)
	(text "Always on (+3V3): wake-up / 6D / activity interrupts while the ESP32 is in deep sleep (~1 uA in low-power wake mode).\nCS high = I2C. SA0 high (never ground it: internal pull-up, see module docstring). RES to GND.\nINT1 -> IMU_INT1 (GPIO15, RTC: deep-sleep wake on pickup), INT2 -> IMU_INT2 (GPIO16). Push-pull, no pull-ups.\n100n + 10u at VDD (pin 9), 100n at VDD_IO (pin 10). Keep away from the buck-boost inductor."
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "ffad3f1c-5e4d-5722-a005-b7fa4724c8a9")
	)
