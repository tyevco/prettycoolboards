# PrettyCool Caliper rev A: ESP32-S3-MINI-1-N4R2 (4 MB quad flash, 2 MB quad PSRAM).
# For the N8R2 add sdkconfig.defaults.8mb (see CMakeLists.txt).

CONFIG_IDF_TARGET="esp32s3"

# ---- flash, partitions --------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_CALIPER_LOG_CAPACITY=4096

# ---- PSRAM (quad, in package) -------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- CPU, power management, tickless idle -------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ---- console: USB-Serial-JTAG until TinyUSB takes the PHY, then the TinyUSB CDC -----------
# UART0 pins (GPIO43/44) are capacitive TX phases, so no UART console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Bluetooth: NimBLE peripheral (custom GATT + BAS + DIS + HID keyboard) ----------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_MAX_BONDS=6
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="PrettyCool Caliper"
CONFIG_BT_NIMBLE_GAP_DEVICE_NAME_MAX_LEN=31
CONFIG_BT_NIMBLE_SVC_GAP_APPEARANCE=0x03C1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# HID over GATT, Battery and Device Information are implemented in components/ble (ble_std.c)
# so the report map and the service layout are under our control; the NimBLE helper services
# for them stay off to avoid duplicate attribute tables.
CONFIG_BT_NIMBLE_HID_SERVICE=n

# ---- Wi-Fi, HTTP, MQTT --------------------------------------------------------------------
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# https:// POST and mqtts:// / wss:// verify the server against the ESP-IDF certificate bundle
# (push.c attaches esp_crt_bundle_attach; without it every TLS connection failed with "no server
# verification option set"). The common-CA subset keeps the flash cost down.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_LWIP_MAX_SOCKETS=12

# ---- USB: TinyUSB composite CDC (console/CLI) + MSC (LOG.CSV) -----------------------------
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="PrettyCool"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="PrettyCool Caliper"
CONFIG_TINYUSB_DESC_CDC_STRING="Caliper console"
CONFIG_TINYUSB_DESC_MSC_STRING="Caliper log"
# esp_tinyusb defaults its task to CPU1, where the sensor (prio 10) and the capacitive burst
# (interrupts masked ~7 ms) run: keep USB work on core 0 with the other I/O tasks.
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y

# ---- storage --------------------------------------------------------------------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
CONFIG_WL_SECTOR_SIZE_4096=y

# ---- drivers ------------------------------------------------------------------------------
CONFIG_PCNT_CTRL_FUNC_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
# The capacitive burst's ADC DMA ISR must keep running while core 0 writes flash (the log, NVS):
# otherwise the 5-frame DMA ring (4 ms at 80 kS/s) is overwritten before the ISR copies it out
# and the burst is demodulated from spliced samples without any error (sensor_cap.c).
CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=y

# ---- LVGL 9 -------------------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_LIST=y
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_DEF_REFR_PERIOD=33
